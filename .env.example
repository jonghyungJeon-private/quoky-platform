# Copy this file to `.env.local` for local Runtime execution.
# Runtime automatically loads `.env.local`; `.env` is not loaded automatically.
# Existing shell/CI environment variables override `.env.local` (the launchd service inherits none; see below).
# Never commit `.env.local` or secret values.

# ── Platform (Discord) ──────────────────────────────────────────────
# Required to start the Discord Runtime. Set the real token only in `.env.local`.
DISCORD_BOT_TOKEN=
# Optional: restrict to a single guild during local development.
DISCORD_GUILD_ID=

# ── Personal edition: who may talk to Quoky (ADR-0091) ───────────────────────
# REQUIRED. Comma-separated Discord USER ids (17-20 digits) allowed to drive Quoky. Startup fails when missing,
# empty, or malformed. Messages from anyone else are silently ignored (no reply). Enable Discord Developer Mode,
# then right-click your name -> Copy User ID.
QUOKY_DISCORD_OWNER_IDS=
# Optional. Comma-separated Discord CHANNEL ids (17-20 digits) where an owner message is a turn; a thread is
# admitted when its own id or its parent channel id is listed. Empty/unset = owner direct messages only.
# No @mention is needed in an admitted channel or DM. A malformed entry fails startup.
QUOKY_DISCORD_CHANNEL_IDS=

# ── Always-on runtime: macOS launchd service (ADR-0102) ──────────────────────
# Optional for `pnpm dev`; REQUIRED in the host `.env.local` when the service runs (ops/launchd/quokyctl.sh install).
# The bot's own Discord user id (17-20 digits; Developer Portal -> General Information -> Application ID). When set,
# startup checks that the connected bot, DISCORD_GUILD_ID and every QUOKY_DISCORD_CHANNEL_IDS entry match before
# reminders start; a mismatch stops the process (DISCORD_IDENTITY_MISMATCH, exit code 78).
# QUOKY_DISCORD_EXPECTED_BOT_ID=
# The service needs this file at mode 600 (chmod 600 .env.local) and builds its environment from nothing else.
# Written by the launcher only, never in this file: QUOKY_ENV_FILE, QUOKY_LAUNCHER, QUOKY_LAUNCHER_RECENT_STARTS.
# Under the service the launcher also sets QUOKY_RUNTIME_ENV=prod and QUOKY_DB_PATH / QUOKY_VECTOR_PATH under
# ~/Library/Application Support/Quoky, which win over the values in this file.

# ── Canonical GitHub App configuration ────────────────────────────
# Required together to identify the repository used by repository-hosting operations.
# QUOKY_GITHUB_OWNER=
# QUOKY_GITHUB_REPO=

# Production repository-hosting authentication uses a GitHub App.
QUOKY_GITHUB_APP_ID=
# Preferred: path to a local PEM file outside Git. Never commit the key file.
QUOKY_GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative to PRIVATE_KEY_PATH; inline PEM is supported but not recommended.
# When both are set, QUOKY_GITHUB_APP_PRIVATE_KEY takes precedence.
# QUOKY_GITHUB_APP_PRIVATE_KEY=
# Optional: skips installation lookup through the configured owner/repository.
QUOKY_GITHUB_APP_INSTALLATION_ID=

# ── Runtime mode ──────────────────────────────────────────────────────
# Optional: dev | prod. Takes precedence over NODE_ENV.
QUOKY_RUNTIME_ENV=
# Fallback: NODE_ENV=production selects prod; all other values select dev.
NODE_ENV=
# Stage 2B Provider routing stays dormant by default. Enabled admission requires a future concrete 5C-EG verifier.
# Leave unset (legacy routing). Personal v1 does not use the Stage 2B mode. Do not add this key with an empty value.

# Non-secret JSON array linking existing Discord Actors to personal-work identities.
# Jira values are assignee identifiers (not necessarily email); GitHub values are logins.
# Omit a target to preserve any stored identity. Never put tokens, credentials, installation ids, owners, or tenants here.
# QUOKY_ACTOR_IDENTITY_MAPPINGS=[{"actor":{"platform":"discord","externalId":"123456789"},"identities":{"jira":"jira-account-id","github":"octocat"}}]

# Static AgentProfile configuration (ADR-0089 / M3E-6H). Non-secret persona configuration only, read once at
# startup and frozen; there is no reload. Each entry accepts exactly these five fields:
#   id            stable identifier, [A-Za-z0-9] then [A-Za-z0-9._:-], up to 128 characters, never normalized
#   displayName   up to 128 characters
#   role          up to 128 characters
#   purpose       up to 1024 characters
#   instructions  up to 16384 characters of persona guidance
# Any other key fails startup, including provider/model pins, API keys, credential or secret references,
# executable paths, commands, Tool allowlists, capabilities, permissions and approval flags. A profile is not
# an Actor or Provider, selects no Provider, and grants no capability, Tool authority or execution permission.
# Omitted or an empty array means no configured profile, which keeps continuation fail-closed. Duplicate ids
# are rejected. Never put secrets in instructions.
# QUOKY_AGENT_PROFILES=[{"id":"receiver","displayName":"Receiver","role":"implementer","purpose":"continue delegated work","instructions":"Follow the handoff objective."}]

# ── Environment-name compatibility (ADR-0086 proposal) ─────────────
# QUOKY_* is canonical; each corresponding CHUNSIK_* alias remains accepted.
# If both are defined, QUOKY_* wins, including an empty value. To use only a
# legacy alias, omit its QUOKY_* counterpart rather than leaving it blank.
# Applies to GITHUB_OWNER/REPO/TOKEN, DB_PATH, VECTOR_PATH, WORKSPACE_ROOT,
# JIRA_BASE_URL/EMAIL/TOKEN, SLACK_TOKEN, CONFLUENCE_BASE_URL/TOKEN.
# Dev-only PAT fallback; GitHub App authentication precedence is unchanged.
# Production repository hosting requires GitHub App auth.
# QUOKY_GITHUB_TOKEN=

# ── Local storage (SQLite) ─────────────────────────────────────
# Relative paths resolve against the repository root (not the shell's working directory).
QUOKY_DB_PATH=./data/chunsik.db

# ── Local vector store ───────────────────────────────────────────────
# Relative paths resolve against the repository root.
QUOKY_VECTOR_PATH=./data/vectors

# ── Workspace (local clone) ──────────────────────────────────────
# Optional. Defaults to the Runtime working directory when omitted.
# QUOKY_WORKSPACE_ROOT=

# ── AI CLI providers (no API keys; CLIs must be installed and authenticated) ──
# Keep these non-secret defaults non-empty because empty values disable config fallbacks.
CLAUDE_CLI_BIN=claude
# CODEX_CLI_BIN is read by configuration, but the Codex provider is not wired
# into the current Runtime composition.
CODEX_CLI_BIN=codex
# Ollama readiness (daemon answering and OLLAMA_MODEL present locally) is probed per request, and an unready
# Ollama is never selected (Claude is used instead). Registration is controlled by QUOKY_OLLAMA_ENABLED
# (exact true/false; default true; never inferred from OLLAMA_MODEL). Set false for a Claude-only runtime.
# Leave commented to use the default; an empty value (QUOKY_OLLAMA_ENABLED=) is a startup error.
# QUOKY_OLLAMA_ENABLED=true
OLLAMA_CLI_BIN=ollama
OLLAMA_MODEL=llama3.1
# Claude model alias or full name passed as --model (letters, digits, . _ : / [ ] -; up to 128 chars). Default sonnet.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_CLAUDE_MODEL=sonnet

# ── Personal edition: git safety (ADR-0094) ──────────────────────────────────
# Exact true/false, default false. While false, push / remote read / main sync / post-merge branch cleanup are
# refused before any git process or credential is used. Commits on main/master (or a detached HEAD) are always
# refused: check out a feature branch first. Enabling this alone does not bypass approval gates.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_GIT_REMOTE_ENABLED=false

# Exact true/false, default false (ADR-0099). Requires QUOKY_GIT_REMOTE_ENABLED=true: enabling merge while the
# remote is off is a startup error (GIT_MERGE_REQUIRES_REMOTE). Parsing this variable authorizes nothing by itself;
# merge stays a separate human-gated action.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_GIT_MERGE_ENABLED=false

# ── Personal v2: work summary (ADR-0100) ─────────────────────────────────────
# Exact true/false, default true (on). Summaries of Jira/Slack/Confluence lookups may fall back to Claude when
# Ollama is not ready, so corporate connector text can leave this machine through your Claude subscription
# (ADR-0100). Set false to turn summarisation off entirely (for example, if workplace policy forbids it).
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_WORK_SUMMARY_ENABLED=true
# Slack search needs a Slack USER token (xoxp-) with the search:read scope (a bot token cannot call search). Put it
# in QUOKY_SLACK_TOKEN below (scopes listed there).

# ── Personal v2: reminders (ADR-0101) ────────────────────────────────────────
# Exact true/false, default false: reminders are off until you enable them.
# QUOKY_REMINDERS_ENABLED=false
# Exact true/false, default false: reminders are delivered to your Discord DM only. Inert while reminders are off.
# WARNING: true delivers a reminder to the allowlisted channel/thread where it was created, so every member of
# that channel can read the reminder text. Enable it only when you accept that.
# QUOKY_REMINDERS_CHANNEL_DELIVERY=false
# IANA time zone for reminders, default Asia/Seoul. An invalid zone is a startup error.
# QUOKY_TIMEZONE=Asia/Seoul

# ── Personal v2: local embedding recall (ADR-0098) ───────────────────────────
# Exact true/false, default false: recall stays lexical. When true, recall re-ranks with a LOCAL Ollama embedding
# model; any failure falls back to lexical. The model is never pulled automatically. Pull it yourself first:
#   ollama pull nomic-embed-text
# QUOKY_EMBEDDING_ENABLED=false
# Local Ollama model name, optionally name:tag (lowercase letters, digits, . _ -; up to 64 chars each). Default
# nomic-embed-text. A name or tag containing "cloud" is refused (embeddings never leave this machine).
# QUOKY_EMBEDDING_MODEL=nomic-embed-text
# Timeout for one embedding call in milliseconds (100-30000). Default 3000.
# QUOKY_EMBEDDING_TIMEOUT_MS=3000

# ── Personal v3: owner-curated learning (ADR-0107) ───────────────────────────
# The learning commands ("피드백 후보", "후보 N 메모: …", "후보 N 예시로 저장", "예시 목록", "예시 N 수정: …",
# "예시 N 삭제") are always available. They store text only when you run one on one item, keep it on this machine
# (LOCAL_ONLY), refuse anything that looks like a credential, and delete it after 365 days.
# Exact true/false, default false: curated examples are NOT added to prompts. Reserved for LRN-2 (examples reach
# only providers that declare local execution); nothing reads it before LRN-2 ships.
# QUOKY_LEARNING_EXAMPLES_ENABLED=false

# ── Memory archive (ADR-0106 amendment) ──────────────────────────────────────
# "기억 N 잊어줘" (confirmed) moves the memory to the archive ("보관함"): it is no longer used anywhere and can be
# restored with "기억 복원 N" or deleted at once with "기억 완전 삭제 N". After this many days the daily maintenance
# deletes it for good. Whole days 0-365, default 7; 0 = no archive (forget deletes permanently at once). Anything
# else (including an empty value) is a startup error. Text that looks like a credential is never archived.
# QUOKY_MEMORY_ARCHIVE_DAYS=7

# ── Conversation context budget ──────────────────────────────────────────────
# Positive integer (max 200000): ESTIMATED tokens of memory/context included per GENERAL_CHAT turn. Default 6000.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_CONTEXT_MAX_TOKENS=6000

# ── Read-only connectors (optional; incomplete groups are not registered) ──
# Leave canonical keys omitted when using legacy CHUNSIK_* aliases; uncomment only when configuring them.
# Atlassian Cloud: Jira and Confluence on the same site share ONE Atlassian API token, created for your account at
# https://id.atlassian.com/manage-profile/security/api-tokens. Use the same value for QUOKY_JIRA_TOKEN and
# QUOKY_CONFLUENCE_TOKEN.
# Jira Cloud uses Basic auth (email:token) and requires all three values.
# BASE_URL must be an HTTPS origin only (no path), for example https://your-site.atlassian.net.
# QUOKY_JIRA_BASE_URL=
# QUOKY_JIRA_EMAIL=
# QUOKY_JIRA_TOKEN=
# Slack USER token (xoxp-). Scopes: search:read (message search), channels:read (channel list), channels:history
# (public channel messages/threads). Add groups:history only if you will read private-channel messages by id
# (the channel list covers public channels only, so groups:read is not needed).
# QUOKY_SLACK_TOKEN=
# Confluence: BASE_URL and TOKEN are required. BASE_URL may be the site root or end in /wiki, for example
# https://your-site.atlassian.net or https://your-site.atlassian.net/wiki (requests go to /wiki/... exactly once).
# Auth: with an email → Basic email:token (Atlassian Cloud API token); without → Bearer (Data Center PAT).
# The email is QUOKY_CONFLUENCE_EMAIL; if that is unset and QUOKY_JIRA_EMAIL is set with a Jira BASE_URL on the
# SAME host, the Jira email is reused (same Atlassian account). Set QUOKY_CONFLUENCE_EMAIL= (empty) to force Bearer.
# QUOKY_CONFLUENCE_BASE_URL=
# QUOKY_CONFLUENCE_EMAIL=
# QUOKY_CONFLUENCE_TOKEN=

# ── Personal v3: read-only calendar (ADR-0110; optional, incomplete groups are not registered) ──
# Google Calendar, scope calendar.readonly only (Quoky never creates, moves or deletes events). The calendar is
# registered only when the client id, client secret and ONE refresh-token source are all set; otherwise schedule
# questions keep today's behaviour. Times are shown in QUOKY_TIMEZONE (see the reminders section).
# The OAuth client is a "Desktop app" client from your own Google Cloud project (Google Calendar API enabled).
# QUOKY_CALENDAR_GOOGLE_CLIENT_ID=
# QUOKY_CALENDAR_GOOGLE_CLIENT_SECRET=
# Refresh token: prefer the token file. Run the one-time consent helper (it prints a URL, never the token):
#   pnpm build && node apps/quoky/dist/tools/calendar-auth.js --out ./data/google-calendar-token.json
# It writes a NEW file with mode 600; then set the path here (relative paths resolve from the repository root).
# A file group/others can read, a symlink, or a broader scope than calendar.readonly is refused.
# QUOKY_CALENDAR_GOOGLE_TOKEN_FILE=./data/google-calendar-token.json
# Or the refresh token inline (not both; setting both leaves the calendar unregistered).
# QUOKY_CALENDAR_GOOGLE_REFRESH_TOKEN=
# Comma-separated calendar ids to read, default primary (at most 10), for example primary,team@group.calendar.google.com
# QUOKY_CALENDAR_GOOGLE_CALENDAR_IDS=primary
