# Copy this file to `.env.local` for local Runtime execution.
# Runtime automatically loads `.env.local`; `.env` is not loaded automatically.
# Existing shell/CI environment variables override `.env.local` (the launchd service inherits none; see below).
# Never commit `.env.local` or secret values.

# ── Platform (Discord) ──────────────────────────────────────────────
# Required to start the Discord Runtime. Set the real token only in `.env.local`.
DISCORD_BOT_TOKEN=
# Optional: restrict to a single guild during local development.
DISCORD_GUILD_ID=

# ── Personal edition: who may talk to Quoky (ADR-0091) ───────────────────────
# REQUIRED. Comma-separated Discord USER ids (17-20 digits) allowed to drive Quoky. Startup fails when missing,
# empty, or malformed. Messages from anyone else are silently ignored (no reply). Enable Discord Developer Mode,
# then right-click your name -> Copy User ID.
QUOKY_DISCORD_OWNER_IDS=
# Optional. Comma-separated Discord CHANNEL ids (17-20 digits) where an owner message is a turn; a thread is
# admitted when its own id or its parent channel id is listed. Empty/unset = owner direct messages only.
# No @mention is needed in an admitted channel or DM. A malformed entry fails startup.
QUOKY_DISCORD_CHANNEL_IDS=

# ── Platform (Telegram, optional; ADR-0114 TG-1) ─────────────────────────────
# Off unless QUOKY_TELEGRAM_ENABLED=true; then every key below is REQUIRED and validated at startup (a missing or
# malformed value stops the process). The bot is created by the owner through BotFather. Long polling only: no
# webhook and no inbound port. Only private chats from the listed owner ids are answered; groups, channels, other
# users and every other update are dropped with no reply. Set the real token only in `.env.local` (mode 600).
# QUOKY_TELEGRAM_ENABLED=false
# QUOKY_TELEGRAM_BOT_TOKEN=
# The bot's numeric user id (the digits before ":" in the token); startup checks getMe against it.
# QUOKY_TELEGRAM_EXPECTED_BOT_ID=
# Comma-separated numeric Telegram USER ids of the owner.
# QUOKY_TELEGRAM_OWNER_IDS=
# Every Telegram owner id mapped to a QUOKY_DISCORD_OWNER_IDS entry: <telegram id>=<discord owner id>, comma-separated.
# The Telegram owner is the same owner (memories, to-dos, reminders) as on Discord.
# QUOKY_TELEGRAM_OWNER_ACTOR_MAP=

# ── Always-on runtime: macOS launchd service (ADR-0102) ──────────────────────
# Optional for `pnpm dev`; REQUIRED in the host `.env.local` when the service runs (ops/launchd/quokyctl.sh install).
# The bot's own Discord user id (17-20 digits; Developer Portal -> General Information -> Application ID). When set,
# startup checks that the connected bot, DISCORD_GUILD_ID and every QUOKY_DISCORD_CHANNEL_IDS entry match before
# reminders start; a mismatch stops the process (DISCORD_IDENTITY_MISMATCH, exit code 78).
# QUOKY_DISCORD_EXPECTED_BOT_ID=
# The service needs this file at mode 600 (chmod 600 .env.local) and builds its environment from nothing else.
# Written by the launcher only, never in this file: QUOKY_ENV_FILE, QUOKY_LAUNCHER, QUOKY_LAUNCHER_RECENT_STARTS.
# Under the service the launcher also sets QUOKY_RUNTIME_ENV=prod and QUOKY_DB_PATH / QUOKY_VECTOR_PATH under
# ~/Library/Application Support/Quoky, which win over the values in this file.

# ── Canonical GitHub App configuration ────────────────────────────
# Code-work repository allowlist (ADR-0109): comma-separated owner/repo, at most 10, validated at startup
# (a malformed, duplicate or 11th entry fails startup). Each registered project's repository is read from its
# workspace origin (HTTPS github.com only) and must be on this list; push/PR/status/merge/cleanup are refused
# otherwise. Install the GitHub App with "Only select repositories" = exactly these repositories.
# QUOKY_GITHUB_REPOS=owner/repo,owner/other-repo
# Legacy single-repository form (an allowlist of one). Setting it together with QUOKY_GITHUB_REPOS fails startup.
# QUOKY_GITHUB_OWNER=
# QUOKY_GITHUB_REPO=

# Production repository-hosting authentication uses a GitHub App.
QUOKY_GITHUB_APP_ID=
# Preferred: path to a local PEM file outside Git. Never commit the key file.
QUOKY_GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative to PRIVATE_KEY_PATH; inline PEM is supported but not recommended.
# When both are set, QUOKY_GITHUB_APP_PRIVATE_KEY takes precedence.
# QUOKY_GITHUB_APP_PRIVATE_KEY=
# Optional pin: used only after the App-JWT lookups confirm it is the repository's installation and its account is
# the repository owner (otherwise refused before any token mint).
QUOKY_GITHUB_APP_INSTALLATION_ID=

# ── Runtime mode ──────────────────────────────────────────────────────
# Optional: dev | prod. Takes precedence over NODE_ENV.
QUOKY_RUNTIME_ENV=
# Fallback: NODE_ENV=production selects prod; all other values select dev.
NODE_ENV=
# Stage 2B Provider routing stays dormant by default. Enabled admission requires a future concrete 5C-EG verifier.
# Leave unset (legacy routing). Personal v1 does not use the Stage 2B mode. Do not add this key with an empty value.

# Non-secret JSON array linking existing Discord Actors to personal-work identities.
# Jira values are assignee identifiers (not necessarily email); GitHub values are logins.
# Omit a target to preserve any stored identity. Never put tokens, credentials, installation ids, owners, or tenants here.
# QUOKY_ACTOR_IDENTITY_MAPPINGS=[{"actor":{"platform":"discord","externalId":"123456789"},"identities":{"jira":"jira-account-id","github":"octocat"}}]

# Static AgentProfile configuration (ADR-0089 / M3E-6H). Non-secret persona configuration only, read once at
# startup and frozen; there is no reload. Each entry accepts exactly these five fields:
#   id            stable identifier, [A-Za-z0-9] then [A-Za-z0-9._:-], up to 128 characters, never normalized
#   displayName   up to 128 characters
#   role          up to 128 characters
#   purpose       up to 1024 characters
#   instructions  up to 16384 characters of persona guidance
# Any other key fails startup, including provider/model pins, API keys, credential or secret references,
# executable paths, commands, Tool allowlists, capabilities, permissions and approval flags. A profile is not
# an Actor or Provider, selects no Provider, and grants no capability, Tool authority or execution permission.
# Omitted or an empty array means no configured profile, which keeps continuation fail-closed. Duplicate ids
# are rejected. Never put secrets in instructions.
# QUOKY_AGENT_PROFILES=[{"id":"receiver","displayName":"Receiver","role":"implementer","purpose":"continue delegated work","instructions":"Follow the handoff objective."}]

# ── Environment-name compatibility (ADR-0086 proposal) ─────────────
# QUOKY_* is canonical; each corresponding CHUNSIK_* alias remains accepted.
# If both are defined, QUOKY_* wins, including an empty value. To use only a
# legacy alias, omit its QUOKY_* counterpart rather than leaving it blank.
# Applies to GITHUB_OWNER/REPO/TOKEN, DB_PATH, VECTOR_PATH, WORKSPACE_ROOT,
# JIRA_BASE_URL/EMAIL/TOKEN, SLACK_TOKEN, CONFLUENCE_BASE_URL/TOKEN.
# Dev-only PAT fallback; GitHub App authentication precedence is unchanged.
# Production repository hosting requires GitHub App auth.
# With a repository allowlist, git push also uses this PAT (via a one-shot askpass): remote git runs with isolated
# config, so your keychain / credential helper is not consulted (ADR-0109).
# QUOKY_GITHUB_TOKEN=

# ── Local storage (SQLite) ─────────────────────────────────────
# Relative paths resolve against the repository root (not the shell's working directory).
QUOKY_DB_PATH=./data/chunsik.db

# ── Local vector store ───────────────────────────────────────────────
# Relative paths resolve against the repository root.
QUOKY_VECTOR_PATH=./data/vectors

# ── Workspace (local clone) ──────────────────────────────────────
# Optional. Defaults to the Runtime working directory when omitted.
# QUOKY_WORKSPACE_ROOT=

# ── AI CLI providers (no API keys; CLIs must be installed and authenticated) ──
# Keep these non-secret defaults non-empty because empty values disable config fallbacks.
CLAUDE_CLI_BIN=claude
# Chat provider selector (ADR-0092 amendment; openai and gemini since ADR-0115): claude | codex | ollama | openai | gemini (exact, lowercase). Claude is always registered
# for code, review and policy-sensitive chat, and is the fallback when the selected provider is not ready.
#   claude = Claude only.  ollama = local Ollama for chat-tier work + Claude.  codex = Codex CLI (OpenAI) for chat,
#   summaries, document analysis and read-only lookups + Claude for everything else. With codex, chat content goes
#   to OpenAI through your logged-in `codex` CLI (`codex login status`).
# Unset = derived from QUOKY_OLLAMA_ENABLED (true -> ollama, false -> claude), so existing files keep working. If both
# are set and disagree, QUOKY_CHAT_PROVIDER wins and startup logs CHAT_PROVIDER_OVERRIDES_OLLAMA_ENABLED.
# An empty value is a startup error (CHAT_PROVIDER_INVALID).
# Runtime switching (ADR-0092/ADR-0111 amendments): this is the configured default. The operations UI can set a
# persisted default (<db dir>/ops/provider-selection.json) and the owner's chat command (`모델 변경: codex`, `/model`)
# overrides it for one conversation; precedence is session > operations UI > this variable > derived default. Codex is
# registered for switching when CODEX_CLI_BIN is present, Ollama chat when OLLAMA_MODEL is set and OLLAMA_CLI_BIN is present.
# QUOKY_CHAT_PROVIDER=claude
# Codex CLI used when QUOKY_CHAT_PROVIDER=codex. Under the launchd service give an absolute path if needed; the CLI
# is a Node script, so `node` must also be on the service PATH.
CODEX_CLI_BIN=codex
# Optional Codex model passed as -m (same shape rule as QUOKY_CLAUDE_MODEL). Unset = the Codex CLI default model.
# An empty value is a startup error (CODEX_MODEL_INVALID).
# QUOKY_CODEX_MODEL=
# Ollama readiness (daemon answering and OLLAMA_MODEL present locally) is probed per request, and an unready
# Ollama is never selected (Claude is used instead). Registration is controlled by QUOKY_OLLAMA_ENABLED
# (exact true/false; default true; never inferred from OLLAMA_MODEL). Set false for a Claude-only runtime.
# Leave commented to use the default; an empty value (QUOKY_OLLAMA_ENABLED=) is a startup error.
# QUOKY_OLLAMA_ENABLED=true
OLLAMA_CLI_BIN=ollama
OLLAMA_MODEL=llama3.1
# Claude model alias or full name passed as --model (letters, digits, . _ : / [ ] -; up to 128 chars). Default sonnet.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_CLAUDE_MODEL=sonnet

# ── Natural-language capability selection (ADR-0120) ─────────────────────────
# off | shadow | active (exact values), default off: every reply is unchanged. shadow runs the selection beside chat
# turns and only logs content-free fields (entry id, route, agree flag, latency); active (Phase A) answers a message that
# would otherwise reach chat with the matching read (Jira, GitHub, Slack, Confluence, calendar, mail, Drive, to-dos,
# reminders, the brief, help), asks one numbered question when unsure, and otherwise chats with the configured-sources
# fact. Only the owner's own text (quoted/fenced/attached content removed) and the catalog go to the selector.
# QUOKY_NL_INTENT_MODE=off
# The Claude CLI model of the selection call (alias or full name, same shape rule as QUOKY_CLAUDE_MODEL). Default haiku.
# QUOKY_NL_INTENT_MODEL=haiku
# The per-call bound of a selection call, in milliseconds (integer 2000-10000). Default 10000 (ADR-0120 amendment A3; owner decision 2026-10-28).
# QUOKY_NL_INTENT_TIMEOUT_MS=10000   (2000-10000; ADR-0120 A3, owner decision 2026-10-28)
# ADR-0120 amendment A2 (Proposed): let Class B listing grammars yield to selection when leftover content words remain.
# Turning it on sends messages that a grammar answers on the host today to the selector (D8 egress): it needs A2
# ratified and the owner's explicit yes. Only takes effect with QUOKY_NL_INTENT_MODE=active.
# QUOKY_NL_GRAMMAR_YIELD=off
# ADR-0120 D6 phase (ADR-0121 S1): a (default) | c, exact values. c = Phase C: selection runs BEFORE the frozen Class B
# grammars (calendar/mail/Drive listings, work lookups, help-intent, the personal-work surface); the grammar answers only
# when the selector is unavailable (down, timeout, provider family/locality mismatch, credential, too long). Class A
# commands (anchors, approvals, writes, memory, code work, reminder creation) are never preceded by selection. c with
# QUOKY_NL_INTENT_MODE=shadow is a startup error (use c-shadow with active instead). Sends grammar-answered messages to the selector
# (D8 egress; owner yes for S1 on 2026-10-13). Adds one selection call (about 1.2-3 s) to those messages.
# c-shadow (only with QUOKY_NL_INTENT_MODE=active, otherwise a startup error): Phase A stays fully live, and after a
# grammar has answered, one background selection runs and only logs nl_selection.agreement (no added reply latency).
# QUOKY_NL_PHASE=a
# ADR-0120 amendment A6: natural-language actions. off (default) | shadow | local | external, exact values. off offers no
# action entry, writes no action record and keeps every prompt and reply byte-identical (nl-select.v20). Any other value
# needs QUOKY_NL_INTENT_MODE=active (a startup error otherwise) and the persisted kill switch (always built; the owner's
# "에이전트 중지" / "에이전트 재개" in the DM). shadow logs content-free nl_action.decided lines only; local lets to-do and
# reminder actions, undo and item summaries act; external (R3) is refused at startup until R3. Each level is a Strict owner step.
# QUOKY_NL_ACTIONS=off

# ── Bounded read agent (ADR-0121 stage S2) ────────────────────────────────────
# off | shadow (exact values), default off: every reply is unchanged and nothing extra runs. shadow (needs
# QUOKY_NL_INTENT_MODE=active, otherwise a startup error) plans in the background after an owner DM turn that reached
# selection: one extra planner call (the same INTENT_SELECTION provider, at most 1 in flight, 30 an hour, 150 a day),
# no connector read, no summary call, and one content-free agent_run.shadow log line. active is refused at startup
# (AGENT_MODE_ACTIVE_NOT_RELEASED) until the ADR-0121 D11 gates pass. The owner's "에이전트 중지" / "에이전트 재개" in the
# DM stops and resumes it without a restart (the same switch as natural-language actions).
# QUOKY_AGENT_MODE=off

# ── Egress guard and traffic ledger (ADR-0121 S0) ─────────────────────────────
# off | observe | enforce (exact values), default observe. The guard covers Quoky's own Node HTTP paths (fetch/undici,
# discord.js REST, the http/https agents): an allowlist derived from the connectors configured here, a connection-bound
# DNS check that refuses private, loopback, link-local/metadata (169.254.169.254), CGNAT (100.64/10), ULA and
# IPv4-mapped addresses and pins the checked IP, per-connector request/volume budgets with backoff on 429/5xx, and a
# content-free ledger at <data dir>/audit/egress-YYYY-MM-DD.jsonl (host, label, method, path template, status, bytes,
# latency; never a header, token, query or body). observe logs findings and never blocks; enforce refuses them.
# Child processes (claude -p, ollama, git) are NOT covered by this in-process guard.
# QUOKY_EGRESS_GUARD=observe
# Size cap of one daily ledger file part in MB (integer 1-256; up to 4 parts a day). Default 16.
# QUOKY_EGRESS_LEDGER_MAX_FILE_MB=16
# Days the ledger files are kept (integer 1-365). Default 90.
# QUOKY_EGRESS_LEDGER_RETENTION_DAYS=90

# ── OpenAI API provider (ADR-0115; chat tier and image understanding only) ────
# Off unless BOTH are set. Selected with QUOKY_CHAT_PROVIDER=openai / QUOKY_IMAGE_UNDERSTANDING_PROVIDER=openai, the
# operations UI, or `모델 변경: openai[:<model>]`; otherwise it never answers. Chat content (and, for images, the attached
# image bytes) then goes to OpenAI and is billed per token. No tool definitions are sent, `store: false`, endpoint pinned
# to https://api.openai.com. Code, review, planning, tests and policy-sensitive chat stay on Claude.
# The key is a secret: keep it only in .env.local (chmod 600); it is never logged. A malformed key, a model off the
# allow-list (gpt-5.1, gpt-5, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, gpt-4o, gpt-4o-mini), or one
# of the two without the other is a startup error (OPENAI_API_KEY_INVALID / OPENAI_MODEL_INVALID / *_MISSING).
# QUOKY_OPENAI_API_KEY=
# QUOKY_OPENAI_MODEL=

# ── Gemini API provider (ADR-0115 D4, PRV-2; chat tier and image understanding only) ────
# Off unless BOTH are set. Selected with QUOKY_CHAT_PROVIDER=gemini / QUOKY_IMAGE_UNDERSTANDING_PROVIDER=gemini, the
# operations UI, or `모델 변경: gemini[:<model>]`; otherwise it never answers. Chat content (and, for images, the attached
# image bytes) then goes to Google and is billed per token. No tools, function declarations, code execution or Search
# grounding are sent; endpoint pinned to https://generativelanguage.googleapis.com; the key travels only in the
# x-goog-api-key header (never in a URL). Code, review, planning, tests and policy-sensitive chat stay on Claude.
# The key (a Google AI Studio API key, "AIza…") is a secret: keep it only in .env.local (chmod 600); it is never logged.
# A malformed key, a model off the allow-list (gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.1-pro-preview), or one of the two without the other is a
# startup error (GEMINI_API_KEY_INVALID / GEMINI_MODEL_INVALID / *_MISSING).
# QUOKY_GEMINI_API_KEY=
# QUOKY_GEMINI_MODEL=

# ── Provider usage ledger and notices (ADR-0115 D8, PRV-3) ────
# Each answered turn records the token counts its provider reported (OpenAI, Gemini, and Codex when it reports them; the
# Claude CLI and Ollama report none, shown as "미보고") in the existing run record; nothing is estimated and nothing is
# changed in the database. The operations UI shows the current and previous month per provider label (QUOKY_TIMEZONE).
# Once a month the owner gets one DM with the previous month's totals. OPTIONAL: set a monthly threshold, in TOTAL TOKENS per
# calendar month across all providers, to get one more DM the first time a month reaches it (unset or empty = no
# threshold notice). A positive whole number only; anything else is the startup error PROVIDER_USAGE_THRESHOLD_INVALID.
# Quoky never switches, disables or re-ranks a provider because of usage.
# QUOKY_PROVIDER_USAGE_MONTHLY_THRESHOLD=

# ── Image understanding provider (ADR-0111 and its 2026-10-07 / 2026-10-08 amendments) ────
# Which provider reads image attachments: exactly one of ollama | claude | codex | openai | gemini | off (lowercase; anything else,
# including an empty value, is the startup error IMAGE_UNDERSTANDING_PROVIDER_INVALID).
#   unset  -> ollama when QUOKY_OLLAMA_VISION_MODEL is set, otherwise off (the behaviour before this setting existed;
#             an unusable vision model then only disables image understanding)
#   ollama -> local Ollama vision model QUOKY_OLLAMA_VISION_MODEL (required; pull it yourself, *cloud* refused);
#             image bytes never leave this host
#   claude -> the Claude CLI reads images: ATTACHED IMAGES ARE SENT TO ANTHROPIC (cloud). Explicit owner opt-in only.
#             Model: QUOKY_IMAGE_UNDERSTANDING_MODEL, else QUOKY_CLAUDE_MODEL, else sonnet. Needs the CLI logged in.
#             Secrets visible inside an image cannot be detected before sending; captions and text files are checked.
#   codex  -> the Codex CLI reads images: ATTACHED IMAGES ARE SENT TO OPENAI (cloud). Explicit owner opt-in only.
#             Model: QUOKY_CODEX_MODEL (the chat tier's), else the CLI default; QUOKY_IMAGE_UNDERSTANDING_MODEL is not
#             read. Same isolation as Codex chat; each image is copied into an empty temp dir and passed as --image.
#             Needs `codex login`. The same secret caveat as claude applies.
#   openai -> the OpenAI API reads images: ATTACHED IMAGES ARE SENT TO OPENAI (cloud). Explicit owner opt-in only.
#             Model: QUOKY_OPENAI_MODEL; needs QUOKY_OPENAI_API_KEY. Only the canonical image bytes are sent, inline.
#             The same secret caveat as claude applies.
#   gemini -> the Gemini API reads images: ATTACHED IMAGES ARE SENT TO GOOGLE (cloud). Explicit owner opt-in only.
#             Model: QUOKY_GEMINI_MODEL; needs QUOKY_GEMINI_API_KEY. Only the canonical image bytes are sent, inline
#             (a request over 20 MB in all is refused, never uploaded). The same secret caveat as claude applies.
#   off    -> no image analysis; image turns get a fixed "not analysed, not sent anywhere" reply
# QUOKY_IMAGE_UNDERSTANDING_PROVIDER=ollama
# QUOKY_OLLAMA_VISION_MODEL=gemma3:4b
# QUOKY_IMAGE_UNDERSTANDING_MODEL=sonnet

# ── Personal edition: git safety (ADR-0094) ──────────────────────────────────
# Exact true/false, default false. While false, push / remote read / main sync / post-merge branch cleanup are
# refused before any git process or credential is used. Commits on main/master (or a detached HEAD) are always
# refused: check out a feature branch first. Enabling this alone does not bypass approval gates.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_GIT_REMOTE_ENABLED=false

# Exact true/false, default false (ADR-0099). Requires QUOKY_GIT_REMOTE_ENABLED=true: enabling merge while the
# remote is off is a startup error (GIT_MERGE_REQUIRES_REMOTE). Parsing this variable authorizes nothing by itself;
# merge stays a separate human-gated action.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_GIT_MERGE_ENABLED=false

# ── Personal v2: work summary (ADR-0100) ─────────────────────────────────────
# Exact true/false, default true (on). Summaries of Jira/Slack/Confluence lookups may fall back to Claude when
# Ollama is not ready, so corporate connector text can leave this machine through your Claude subscription
# (ADR-0100). Set false to turn summarisation off entirely (for example, if workplace policy forbids it).
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_WORK_SUMMARY_ENABLED=true
# Slack search needs a Slack USER token (xoxp-) with the search:read scope (a bot token cannot call search). Put it
# in QUOKY_SLACK_TOKEN below (scopes listed there).

# ── Personal v2: reminders (ADR-0101) ────────────────────────────────────────
# Exact true/false, default true (ADR-0102 D9, owner decision 8: release default flipped once the always-on
# runtime was live). Set false to turn reminders off; a reminder phrase then gets a fixed "off" reply.
# QUOKY_REMINDERS_ENABLED=true
# Exact true/false, default false: reminders are delivered to your Discord DM only. Inert while reminders are off.
# WARNING: true delivers a reminder to the allowlisted channel/thread where it was created, so every member of
# that channel can read the reminder text. Enable it only when you accept that.
# QUOKY_REMINDERS_CHANNEL_DELIVERY=false
# ADR-0117 D2, exact true/false, default false. When true AND the read-only Jira connector is configured AND your Jira
# account is linked, the daily brief adds your assigned Jira items due or updated today (at most 5, key and title only).
# The brief's calendar section needs no flag: it appears whenever the calendar below is configured.
# QUOKY_BRIEF_JIRA_ENABLED=false
# ADR-0117 amendment (BRF-3), exact true/false, default false. When true AND Gmail is configured (below), the daily brief
# adds an "안 읽은 메일" section: the unread count and at most 3 sender/subject lines (never a body or snippet). No model
# is called, the brief stays DM-only, and an unreadable mailbox shows "불러오지 못했어요". One extra Gmail search per brief.
# QUOKY_BRIEF_MAIL_ENABLED=false
# IANA time zone for reminders, default Asia/Seoul. An invalid zone is a startup error.
# QUOKY_TIMEZONE=Asia/Seoul

# ── Personal v2: local embedding recall (ADR-0098) ───────────────────────────
# Exact true/false, default false: recall stays lexical. When true, recall re-ranks with a LOCAL Ollama embedding
# model; any failure falls back to lexical. The model is never pulled automatically. Pull it yourself first:
#   ollama pull nomic-embed-text
# QUOKY_EMBEDDING_ENABLED=false
# Local Ollama model name, optionally name:tag (lowercase letters, digits, . _ -; up to 64 chars each). Default
# nomic-embed-text. A name or tag containing "cloud" is refused (embeddings never leave this machine).
# QUOKY_EMBEDDING_MODEL=nomic-embed-text
# Timeout for one embedding call in milliseconds (100-30000). Default 3000.
# QUOKY_EMBEDDING_TIMEOUT_MS=3000

# ── Personal v3: owner-curated learning (ADR-0107) ───────────────────────────
# The learning commands ("피드백 후보", "후보 N 메모: …", "후보 N 예시로 저장", "예시 목록", "예시 N 수정: …",
# "예시 N 삭제") are always available. They store text only when you run one on one item, keep it on this machine
# (LOCAL_ONLY), refuse anything that looks like a credential, and delete it after 365 days.
# Exact true/false, default false: curated examples are NOT added to prompts. Reserved for LRN-2 (examples reach
# only providers that declare local execution); nothing reads it before LRN-2 ships.
# QUOKY_LEARNING_EXAMPLES_ENABLED=false
# ADR-0116, exact true/false, default false; only has an effect with QUOKY_LEARNING_EXAMPLES_ENABLED=true. When true,
# curated examples may also be sent to a cloud chat provider, but ONLY when you selected it yourself: "모델 변경" in
# the conversation, the operations-UI /providers default, or QUOKY_CHAT_PROVIDER set explicitly. A derived default
# (QUOKY_CHAT_PROVIDER unset) and the Claude fallback when your chosen model is not ready never get examples.
# QUOKY_LEARNING_EXAMPLES_REMOTE_ENABLED=false

# ── Memory archive (ADR-0106 amendment) ──────────────────────────────────────
# "기억 N 잊어줘" (confirmed) moves the memory to the archive ("보관함"): it is no longer used anywhere and can be
# restored with "기억 복원 N" or deleted at once with "기억 완전 삭제 N". After this many days the daily maintenance
# deletes it for good. Whole days 0-365, default 7; 0 = no archive (forget deletes permanently at once). Anything
# else (including an empty value) is a startup error. Text that looks like a credential is never archived.
# QUOKY_MEMORY_ARCHIVE_DAYS=7

# ── Local operations UI (ADR-0113; optional, OFF by default) ──────────────────
# A loopback-only web screen inside the Quoky process: http://127.0.0.1:<port>/ on this Mac only (no LAN, tunnel or
# bind-address setting exists). Sign in with the per-start token Quoky writes to ops-ui.token (mode 600) in the database
# directory. It shows status read-only, can cancel reminders and forget memories, and can reject or approve a pending
# approval: approving needs the 6-character "운영 화면 확인 코드" line that chat then adds to the approval preview, and
# records the approval only (a commit, push, PR, merge or connector write still runs only on its exact chat phrase).
# The result of a UI decision is sent to your Discord DM (OPS_DECISION_RESULT).
# Exact true/false, default false. Any other value disables only the UI (log code OPS_UI_ENABLED_INVALID).
# QUOKY_OPS_UI_ENABLED=false
# Port 1024-65535, default 47613. Out of range disables only the UI (OPS_UI_PORT_INVALID); a taken port too.
# QUOKY_OPS_UI_PORT=47613

# ── Conversation context budget ──────────────────────────────────────────────
# Positive integer (max 200000): ESTIMATED tokens of memory/context included per GENERAL_CHAT turn. Default 6000.
# Leave commented to use the default; an empty value is a startup error.
# QUOKY_CONTEXT_MAX_TOKENS=6000

# ── Read-only connectors (optional; incomplete groups are not registered) ──
# Leave canonical keys omitted when using legacy CHUNSIK_* aliases; uncomment only when configuring them.
# Atlassian Cloud: Jira and Confluence on the same site share ONE Atlassian API token, created for your account at
# https://id.atlassian.com/manage-profile/security/api-tokens. Use the same value for QUOKY_JIRA_TOKEN and
# QUOKY_CONFLUENCE_TOKEN.
# Jira Cloud uses Basic auth (email:token) and requires all three values.
# BASE_URL must be an HTTPS origin only (no path), for example https://your-site.atlassian.net.
# QUOKY_JIRA_BASE_URL=
# QUOKY_JIRA_EMAIL=
# QUOKY_JIRA_TOKEN=
# Slack USER token (xoxp-). Scopes: search:read (message search), channels:read (channel list), channels:history
# (public channel messages/threads). Add groups:history only if you will read private-channel messages by id
# (the channel list covers public channels only, so groups:read is not needed).
# QUOKY_SLACK_TOKEN=
# Confluence: BASE_URL and TOKEN are required. BASE_URL may be the site root or end in /wiki, for example
# https://your-site.atlassian.net or https://your-site.atlassian.net/wiki (requests go to /wiki/... exactly once).
# Auth: with an email → Basic email:token (Atlassian Cloud API token); without → Bearer (Data Center PAT).
# The email is QUOKY_CONFLUENCE_EMAIL; if that is unset and QUOKY_JIRA_EMAIL is set with a Jira BASE_URL on the
# SAME host, the Jira email is reused (same Atlassian account). Set QUOKY_CONFLUENCE_EMAIL= (empty) to force Bearer.
# QUOKY_CONFLUENCE_BASE_URL=
# QUOKY_CONFLUENCE_EMAIL=
# QUOKY_CONFLUENCE_TOKEN=

# ── Personal v3: read-only calendar (ADR-0110; optional, incomplete groups are not registered) ──
# Google Calendar, scope calendar.readonly (writes are a separate opt-in, see "connector writes" below). The calendar is
# registered only when the client id, client secret and ONE refresh-token source are all set; otherwise schedule
# questions keep today's behaviour. Times are shown in QUOKY_TIMEZONE (see the reminders section).
# The OAuth client is a "Desktop app" client from your own Google Cloud project (Google Calendar API enabled).
# QUOKY_CALENDAR_GOOGLE_CLIENT_ID=
# QUOKY_CALENDAR_GOOGLE_CLIENT_SECRET=
# Refresh token: prefer the token file. Run the one-time consent helper (it prints a URL, never the token):
#   pnpm build && node apps/quoky/dist/tools/calendar-auth.js --out ./data/google-calendar-token.json
# It writes a NEW file with mode 600; then set the path here (relative paths resolve from the repository root).
# A file group/others can read, a symlink, or a scope beyond calendar.readonly (+ calendar.events, see below) is refused.
# QUOKY_CALENDAR_GOOGLE_TOKEN_FILE=./data/google-calendar-token.json
# Or the refresh token inline (not both; setting both leaves the calendar unregistered).
# QUOKY_CALENDAR_GOOGLE_REFRESH_TOKEN=
# Comma-separated calendar ids to read, default primary (at most 10), for example primary,team@group.calendar.google.com
# QUOKY_CALENDAR_GOOGLE_CALENDAR_IDS=primary

# ── Personal v4: read-only Gmail (ADR-0118; optional, OFF unless the OAuth client and QUOKY_GMAIL_TOKEN_FILE are set) ──
# Scope gmail.readonly only: Quoky lists and, when you ask for one, summarizes mail. It never sends, replies, drafts,
# labels, archives or deletes. Answers come only in your DM. Uses the same OAuth client as the calendar
# (QUOKY_CALENDAR_GOOGLE_CLIENT_ID / _SECRET; enable the Gmail API in that Google Cloud project). Consent is a separate
# grant written to its own token file (Strict, owner step; it prints a URL, never the token):
#   pnpm build && node apps/quoky/dist/tools/calendar-auth.js --out ./data/google-gmail-token.json --gmail
# A file group/others can read, a symlink, or any scope other than gmail.readonly is refused. To revoke: remove Quoky at
# https://myaccount.google.com/permissions, delete the token file and remove this line. Gmail and the calendar share one
# OAuth client, so removing Quoky there ALSO revokes the calendar grant (re-run the calendar consent if you keep it).
# QUOKY_GMAIL_TOKEN_FILE=./data/google-gmail-token.json

# ── Personal v4: read-only Google Drive (ADR-0118, DRV-1; optional, OFF unless the OAuth client and QUOKY_DRIVE_TOKEN_FILE are set) ──
# Scope drive.readonly only: Quoky lists your recent files, searches them by name and, when you ask for one, summarizes
# the text of one Google Doc, Sheet or text file. It never uploads, edits, moves, renames, shares or deletes. Answers come
# only in your DM. Same OAuth client as the calendar and Gmail (enable the Google Drive API in that project). Consent is
# a separate grant written to its own token file (Strict, owner step; it prints a URL, never the token):
#   pnpm build && node apps/quoky/dist/tools/calendar-auth.js --out ./data/google-drive-token.json --drive
# A file group/others can read, a symlink, or any scope other than drive.readonly is refused. To revoke: remove Quoky at
# https://myaccount.google.com/permissions, delete the token file and remove this line. The calendar, Gmail and Drive
# share one OAuth client, so removing Quoky there revokes ALL of them (re-run the consent for each one you keep).
# QUOKY_DRIVE_TOKEN_FILE=./data/google-drive-token.json

# ── Personal v3: connector writes (ADR-0112, ADR-0110 amendment; all OFF by default) ──
# Writes are irreversible: each one will need an exact preview and a one-time approval in chat (the chat flow ships
# separately). Until then these settings only prepare the writers. A target outside the allowlist is always refused
# before any network call. Each value is validated at startup even while writes are off; a bad value stops startup.
# Master switch for Jira and Slack writes (exact true/false):
# QUOKY_CONNECTOR_WRITES_ENABLED=false
# Jira: comment and status change on issues of these projects only (comma-separated project keys, at most 50).
# Uses the QUOKY_JIRA_* credentials above: an Atlassian API token already permits writes, so this allowlist is the gate.
# QUOKY_CONNECTOR_WRITE_JIRA_PROJECTS=PROJ
# Slack: posts as the Quoky app with a BOT token (scope chat:write, invite the app to each channel), which must be a
# different token from QUOKY_SLACK_TOKEN. Channels are "name:CHANNELID" or "CHANNELID" entries (at most 50); the name is
# what you type after # in chat. Both values are needed; otherwise Slack writes stay off.
# QUOKY_CONNECTOR_WRITE_SLACK_TOKEN=
# QUOKY_CONNECTOR_WRITE_SLACK_CHANNELS=dev-test:C0123ABCD9
# Calendar: create, move and delete events on your PRIMARY calendar only (exact true/false, independent of the master
# switch). Attendees are never set and Google sends no invitations or updates (sendUpdates=none); recurring series are
# not edited. Needs the calendar above with a token that also grants calendar.events: run the consent helper with
#   node apps/quoky/dist/tools/calendar-auth.js --out ./data/google-calendar-token-rw.json --with-events
# and point QUOKY_CALENDAR_GOOGLE_TOKEN_FILE at the new file (a read-only token file leaves calendar writes off).
# QUOKY_CALENDAR_WRITE_ENABLED=false
